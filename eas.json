{
    "cli": {
        "version": ">= 20.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://www.picknbook.in"
            },
            "android": {
                "buildType": "app-bundle"
            }
        }
    }
}
